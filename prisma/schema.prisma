generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model GameSession {
  id       String   @id @default(uuid())
  playedAt DateTime @default(now())
  result   String   // "won" | "lost"
  city     String
  state    String
  country  String

  @@index([city])
  @@index([playedAt])
  @@map("game_sessions")
}
